# Optional. Copy to alerts.yaml to enable an email digest after each run.
# Works with any SMTP provider. Gmail example below uses an App Password
# (not your normal password) - generate one at
# https://myaccount.google.com/apppasswords with 2FA enabled on the account.

enabled: false

smtp_host: "smtp.gmail.com"
smtp_port: 587
use_tls: true
username: "you@gmail.com"
password: "YOUR_APP_PASSWORD"

from_address: "you@gmail.com"
to_address: "you@gmail.com"
